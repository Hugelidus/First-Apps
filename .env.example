# --- LLM ---
# Clave de Anthropic. Pídela en https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Modelos por defecto (no cambiar salvo razón fundada).
CHAT_MODEL=claude-sonnet-4-6
SPOILER_MODEL=claude-haiku-4-5-20251001

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kraken

# --- Embeddings ---
# Modelo local de sentence-transformers. La primera ejecución descarga ~1.5 GB.
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# --- Scraping ---
HTTP_USER_AGENT=CinemaIA-MVP/0.1 (+https://github.com/Hugelidus/First-Apps)
HTTP_RATE_LIMIT_PER_HOST=1.0  # peticiones por segundo

# --- Logging ---
LOG_LEVEL=INFO
